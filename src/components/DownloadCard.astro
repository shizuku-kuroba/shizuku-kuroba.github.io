---
interface Props {
  href: string
  filename: string
  bytes?: number
  meta?: string
  label?: string
}

const { href, filename, bytes, meta, label = '下載檔案' } = Astro.props

const formatFileSize = (size: number) => {
  if (size < 1024) return `${size} B`

  const units = ['KB', 'MB', 'GB']
  let value = size / 1024
  let unit = units[0]

  for (let index = 1; value >= 1024 && index < units.length; index += 1) {
    value /= 1024
    unit = units[index]
  }

  return `${value.toFixed(value >= 10 ? 1 : 2)} ${unit}`
}

const details = [bytes ? formatFileSize(bytes) : undefined, meta].filter(Boolean).join(' · ')
---

<aside class='download-card not-prose' aria-label={`下載 ${filename}`}>
  <span class='download-card__icon' aria-hidden='true'>
    <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8'>
      <path d='M12 3v12m0 0 4-4m-4 4-4-4M5 20h14' stroke-linecap='round' stroke-linejoin='round'
      ></path>
    </svg>
  </span>

  <span class='download-card__details'>
    <strong>{filename}</strong>
    {details && <small>{details}</small>}
  </span>

  <a href={href} download={filename}>{label}</a>
</aside>

<style>
  .download-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-block: 1.75rem;
    padding: 1rem;
    border: 1px solid hsl(var(--border) / 1);
    border-radius: 0.9rem;
    background: hsl(var(--muted) / 0.55);
  }

  .download-card__icon {
    display: grid;
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 0.7rem;
    background: rgba(127, 127, 127, 0.12);
  }

  .download-card__icon svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .download-card__details {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.15rem;
  }

  .download-card__details strong {
    overflow: hidden;
    font-size: 0.95rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .download-card__details small {
    color: hsl(var(--muted-foreground) / 1);
    font-size: 0.78rem;
  }

  .download-card a {
    flex: 0 0 auto;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: hsl(var(--primary) / 1);
    color: hsl(var(--primary-foreground) / 1);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .download-card a:hover {
    opacity: 0.82;
  }

  @media (max-width: 520px) {
    .download-card {
      align-items: stretch;
      flex-wrap: wrap;
    }

    .download-card__details {
      justify-content: center;
    }

    .download-card a {
      width: 100%;
      text-align: center;
    }
  }
</style>
