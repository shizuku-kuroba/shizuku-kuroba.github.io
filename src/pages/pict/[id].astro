---
import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import { extractTumblrImages } from '@/utils/tumblr'

export const prerender = false

const { id } = Astro.params
const tumblrUsername = 'pluvia-sk'

let post: any = null
try {
  const res = await fetch(`https://${tumblrUsername}.tumblr.com/api/read/json?id=${id}`)
  const text = await res.text()

  if (!text.includes('<!DOCTYPE html>')) {
    const jsonString = text.replace('var tumblr_api_read = ', '').replace(/;\s*$/, '')
    const data = JSON.parse(jsonString)
    post = data.posts[0]
  }
} catch (error) {
  console.error('Tumblr fetch failed:', error)
}

if (!post) {
  return Astro.redirect('/404')
}

let title = ''
const images = extractTumblrImages(post)

if (post.type === 'photo') {
  title = post['photo-caption']?.replace(/(<([^>]+)>)/gi, '').trim() || ''
} else if (post.type === 'regular' && post['regular-body']) {
  if (images.length > 0) {
    title =
      post['regular-title'] ||
      post['regular-body']
        .replace(/(<([^>]+)>)/gi, '')
        .substring(0, 50)
        .trim()
  }
}

if (images.length === 0) {
  return Astro.redirect('/404')
}

const date = new Date(post['date-gmt'])
const formatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
})
const formattedDate = formatter.format(date)

const tags = post.tags || []
const noteCount = post['note-count'] || 0
const postUrl = post.url

// Headings variable needed for PageLayout
const headings: any[] = []
---

<PageLayout title={title || 'PICT Detail'} {headings} view>
  <div class='mx-auto flex flex-col gap-6 pt-4 pb-12 w-full'>
    <div class='flex w-full flex-col gap-5'>
      {
        images.map((image, index) => (
          <figure class='relative m-0 flex w-full justify-center overflow-hidden rounded-xl bg-muted/30 p-3 sm:p-5'>
            <img
              src={image.url}
              alt={`${title || 'Tumblr Post Image'} (${index + 1}/${images.length})`}
              width={image.width}
              height={image.height}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding='async'
              class='max-h-[88vh] h-auto w-auto max-w-full rounded-md object-contain shadow-sm'
            />
            {images.length > 1 && (
              <figcaption class='absolute right-5 top-5 rounded-full bg-black/65 px-2.5 py-1 text-xs font-medium tabular-nums text-white backdrop-blur-sm'>
                {index + 1} / {images.length}
              </figcaption>
            )}
          </figure>
        ))
      }
    </div>

    <div class='flex flex-col gap-8 text-sm px-2'>
      <div class='text-muted-foreground font-medium uppercase tracking-wide text-xs'>
        {formattedDate}
      </div>

      <div class='flex flex-col gap-3'>
        <span class='font-bold uppercase tracking-wider text-xs text-foreground'>Share</span>
        <div class='flex gap-4 items-center text-muted-foreground'>
          <a
            href={postUrl}
            target='_blank'
            rel='noopener noreferrer'
            class='hover:text-foreground transition-colors'
            aria-label='Original Post'
          >
            <Icon name='link' class='size-5' />
          </a>
          <a
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(postUrl)}`}
            target='_blank'
            rel='noopener noreferrer'
            class='hover:text-foreground transition-colors'
            aria-label='Share on Twitter'
          >
            <Icon name='x' class='size-5' />
          </a>
        </div>
      </div>

      {
        tags.length > 0 && (
          <div class='flex flex-col gap-3'>
            <span class='font-bold uppercase tracking-wider text-xs text-foreground'>Tagged</span>
            <div class='flex flex-wrap gap-x-3 gap-y-2'>
              {tags.map((tag: string) => (
                <a
                  href={`/pict?tag=${encodeURIComponent(tag)}`}
                  class='text-muted-foreground hover:text-foreground transition-colors'
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )
      }

      <div class='flex flex-col gap-3'>
        <span class='font-bold uppercase tracking-wider text-xs text-foreground'
          >{noteCount} Notes</span
        >
        <div class='pt-4 border-t border-border/50'>
          <a
            href={postUrl}
            target='_blank'
            rel='noopener noreferrer'
            class='inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2'
          >
            View Notes on Tumblr
          </a>
        </div>
      </div>
    </div>
  </div>
</PageLayout>
