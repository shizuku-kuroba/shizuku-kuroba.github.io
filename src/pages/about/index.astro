        description: 'JRPG',
        href: 'https://na.finalfantasy.com/',
        icon: 'https://api.iconify.design/lucide:gamepad-2.svg'
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/shizuku-kuroba',
        text: 'followers',
        api: 'github/shizuku-kuroba'
      },
      {
