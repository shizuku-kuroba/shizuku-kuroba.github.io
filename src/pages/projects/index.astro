---
import PageLayout from '@/layouts/CommonPage.astro'
import GitHubActivity from '@/components/projects/GitHubActivity.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'agent-skills', text: 'Agent Skills' },
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'learnings', text: 'Learnings' }
]
---

<PageLayout title='Projects' {headings} view>
  <GitHubActivity username='shizuku-kuroba' />
  <p>
    If you think it would be useful or interesting to collaborate on a project, please feel free to
    contact me.
  </p>

  <h2 id='agent-skills'>Agent Skills</h2>
  <ProjectSection
    projects={[
      {
        name: 'anki-csv-skill',
        description:
          'An AI agent skill designed for Obsidian to automatically extract vocabulary from notes and generate Anki-compatible CSV files.',
        links: [{ type: 'github', href: 'https://github.com/shizuku-kuroba/anki-csv-skill' }]
      }
    ]}
  />

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: 'Idea-Roulette',
        description:
          '可自訂分類與詞庫的繪圖題目拉霸機，支援本機儲存、匯入/匯出、鎖定單軸與歷史記錄。藝術家與創作者的靈感生成工具！',
        links: [{ type: 'github', href: 'https://github.com/shizuku-kuroba/Idea-Roulette' }]
      },
      {
        name: 'TWST-Event-Notifier',
        description:
          'Twisted Wonderland JP 服活動行程自動整理工具。本專案會定期從 Kamigame 的 TWST 活動頁抓取活動、抽卡與歷年活動資料，產生可訂閱的 iCalendar (.ics) 日曆，並在偵測到新情報時推送到 Discord。',
        links: [{ type: 'github', href: 'https://github.com/shizuku-kuroba/TWST-Event-Notifier' }]
      }
    ]}
  />

  <h2 id='learnings'>Learnings</h2>
  <p class='text-muted-foreground'>待更新... (To be updated)</p>
</PageLayout>
