---
import { Image } from 'astro:assets'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import avatar from '@/assets/avatar.png'
import config from '@/site-config'

const designAndArt = ['Clip Studio Paint', 'Illustrator', 'Photoshop', '平面設計', '簡報設計']
const techAndDev = [
  'HTML',
  'CSS',
  'JavaScript',
  'TypeScript',
  'Vite',
  'Unity',
  'Prompt Engineering'
]
const languages = ['中文', 'English', '日本語', 'Français (Learning)']

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={avatar}
        alt='profile'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='夢の中'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label title='GitHub' as='a' href='https://github.com/shizuku-kuroba' target='_blank'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Lit.Link'
            as='a'
            href='https://lit.link/zh-tw/kurobashizuku'
            target='_blank'
          >
            <Icon name='earth' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground'>Master's student / Designer / Artist / Writer</p>
        <p class='text-muted-foreground leading-relaxed'>
          一隻內斂的俄羅斯藍貓，玩心盎然又怕生。<br />
          平時深深栽在固定幾個坑裡，偶爾會冒出小小勇氣爬出來，嘗試新事物與社交。生活的追求是希望能成為心目中想成為的人。
          <br /><br />
          喜歡的東西有貓咪、電玩遊戲，黑執事長年粉絲。
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>

      {
        allPostsByDate.length > 0 && (
          <Section title='Posts'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='More posts' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }

      <Section title='Experience'>
        <div class='flex flex-col'>
          <!-- Item 1 -->
          <div class='flex gap-4 sm:gap-6'>
            <div class='w-24 text-sm text-muted-foreground shrink-0 text-right pt-1'>
              2025.08.12
            </div>
            <div class='relative flex flex-col items-center'>
              <div class='h-full w-px bg-muted-foreground/30'></div>
              <div class='absolute top-1.5 h-2.5 w-2.5 rounded-full bg-primary/70'></div>
            </div>
            <div class='flex-1 pb-8'>
              <h3 class='text-base font-semibold'>日本語能力試驗N1 合格</h3>
              <p class='mt-2 text-sm text-muted-foreground leading-relaxed'>
                從高三報考日檢N5開始到現在已過關斬將獲取N1合格證書，日文能力得以幫助我閱讀更多的書籍文獻、觀看日本節目、遊玩日本遊戲。
              </p>
            </div>
          </div>
          <!-- Item 2 -->
          <div class='flex gap-4 sm:gap-6'>
            <div class='w-24 text-sm text-muted-foreground shrink-0 text-right pt-1'>2025.05</div>
            <div class='relative flex flex-col items-center'>
              <div class='h-full w-px bg-muted-foreground/30'></div>
              <div class='absolute top-1.5 h-2.5 w-2.5 rounded-full bg-primary/70'></div>
            </div>
            <div class='flex-1 pb-8'>
              <h3 class='text-base font-semibold'>入圍並決選第十五屆放視大賞2025 行動遊戲組</h3>
              <p class='mt-2 text-sm text-muted-foreground leading-relaxed'>
                以大學畢業專題《潘朵拉之庭》一款結合日常輔助功能與虛擬角色互動的手機遊戲應用參賽。
              </p>
            </div>
          </div>
          <!-- Item 3 -->
          <div class='flex gap-4 sm:gap-6'>
            <div class='w-24 text-sm text-muted-foreground shrink-0 text-right pt-1'>2024.03</div>
            <div class='relative flex flex-col items-center'>
              <div class='h-full w-px bg-muted-foreground/30'></div>
              <div class='absolute top-1.5 h-2.5 w-2.5 rounded-full bg-primary/70'></div>
            </div>
            <div class='flex-1 pb-8'>
              <h3 class='text-base font-semibold'>參展同人展 Bring it On!歐美ONLY主題場11</h3>
              <p class='mt-2 text-sm text-muted-foreground leading-relaxed'>
                因為《柏德之門3》而結識了許多同好，而由我經營管理起同人社團「扶倫社」，成立半年後報名了同人展，第一次以攤主的身分參加同人展。（<a
                  href='https://bloodlesstavs.wixsite.com/home'
                  target='_blank'
                  class='underline'>社團網站</a
                >）
              </p>
            </div>
          </div>
          <!-- Item 4 -->
          <div class='flex gap-4 sm:gap-6'>
            <div class='w-24 text-sm text-muted-foreground shrink-0 text-right pt-1'>2022.06</div>
            <div class='relative flex flex-col items-center'>
              <!-- 為了讓最後一項不要有往下延伸的線，我們可以拿掉 h-full -->
              <div class='absolute top-1.5 h-2.5 w-2.5 rounded-full bg-primary/70'></div>
            </div>
            <div class='flex-1 pb-2'>
              <h3 class='text-base font-semibold'>入圍 第三十一屆時報金犢獎 廣告設計類</h3>
              <p class='mt-2 text-sm text-muted-foreground leading-relaxed'>
                以《面膜是肌膚隔絕荒漠的防護罩》投稿森田藥妝廣告平面設計，第一次參加設計類的國際個人比賽。
              </p>
            </div>
          </div>
        </div>
      </Section>

      <Section title='Elements'>
        <div class='grid grid-cols-1 gap-3 sm:grid-cols-2'>
          <ProjectCard
            as='article'
            heading='日常'
            subheading='Daily'
            imagePath='/src/assets/projects/日常.png'
          />
          <ProjectCard
            as='article'
            heading='開發'
            subheading='Dev'
            imagePath='/src/assets/projects/開發.png'
          />
          <ProjectCard
            as='article'
            heading='創作'
            subheading='Creation'
            imagePath='/src/assets/projects/創作.png'
          />
          <ProjectCard
            as='article'
            heading='夢向'
            subheading='Dream'
            imagePath='/src/assets/projects/夢向.png'
          />
        </div>
      </Section>

      <Section title='Dream'>
        <Card heading=''>
          <p class='text-muted-foreground leading-relaxed'>
            遊戲對我而言，遠不只是消遣娛樂，而是改變生命的魔法。我親身體會遊戲如何改變一個人的價值觀念、啟發思考，甚至撫慰內心的創傷，總是觸及人們內心最柔軟的部分。
            <br /><br />
            一款好的遊戲，就像黑暗中的明燈，能為疲憊的心靈帶來一絲慰藉與希望。<br />
            我也因此期待能以自己的創作，為這個世界注入更多溫暖與療癒的力量。
          </p>
        </Card>
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Design & Art' skills={designAndArt} />
        <SkillLayout title='Tech & Dev' skills={techAndDev} />
        <SkillLayout title='Languages' skills={languages} />
      </Section>
    </div>
    <p class='mt-12 text-muted-foreground'>
      <strong><em>Après la pluie, le beau temps.</em></strong>
    </p>
  </main>
</PageLayout>
